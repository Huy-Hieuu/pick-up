{
  "name": "pickup-mobile",
  "version": "1.0.0",
  "engines": {
    "node": "22.23.x"
  },
  "packageManager": "npm@11.19.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.34",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.22",
    "expo-linking": "~57.0.14",
    "expo-location": "~57.0.24",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir ../artifacts/mobile-android-export",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "serve:web": "node scripts/serve-web.mjs",
    "check:expo": "expo install --check",
    "doctor": "expo-doctor"
  },
  "private": true
}
