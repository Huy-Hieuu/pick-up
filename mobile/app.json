{
  "expo": {
    "name": "PickUp",
    "slug": "pickup",
    "scheme": "pickup",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#193E32"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#193E32",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép PickUp chọn ảnh đại diện từ thư viện của bạn.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "PickUp — Ra sân, nhập hội."
    }
  }
}
