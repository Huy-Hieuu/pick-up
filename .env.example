# Local Compose only. Generate with: openssl rand -hex 32
JWT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_MAIL_FROM=noreply@pickup.app
SMTP_USE_TLS=true
APP_PUBLIC_URL=https://pickup.app
APP_PUBLIC_API_URL=https://api.pickup.app
APP_REQUESTS_PER_MINUTE=300
# Set only the network CIDRs of reverse proxies that overwrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

# Optional payment sandbox credentials; without credentials initiation fails closed.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
